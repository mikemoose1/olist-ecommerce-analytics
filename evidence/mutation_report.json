 {
  "rule": "Real payment gaps stay under 0.5% of orders",
  "selector": "assert_payment_mismatch_share_below_threshold",
  "mutation": {
   "sql": [
    "create temp table victims as select order_id from marts.fct_orders where recon_status = 'match' order by order_id limit 600",
    "update marts.fct_payments p set payment_value = payment_value + 50 from (select order_id, min(payment_sequential) s from marts.fct_payments group by 1) m where p.order_id = m.order_id and p.payment_sequential = m.s and p.order_id in (select order_id from victims)",
    "update marts.fct_orders set recon_status = 'overpaid' where order_id in (select order_id from victims)"
   ]
  },
  "baseline": [
   [
    "test.olist_ecommerce_analytics.assert_payment_mismatch_share_below_threshold",
    "pass",
    0
   ]
  ],
  "mutant": [
   [
    "test.olist_ecommerce_analytics.assert_payment_mismatch_share_below_threshold",
    "fail",
    1
   ]
  ],
  "verdict": "PROVEN",
  "seconds": 9.9
 },
